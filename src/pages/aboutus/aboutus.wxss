/* src/pages/aboutus/aboutus.wxss */
page {
  background: #f5f2ec;
}

.about-page {
  min-height: 100vh;
  color: #2e2a25;
}

.hero {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(28, 22, 16, 0.12) 0%, rgba(28, 22, 16, 0.7) 100%);
}

.hero-content {
  position: absolute;
  left: 52rpx;
  right: 52rpx;
  bottom: 58rpx;
  display: flex;
  flex-direction: column;
  color: #fff;
}

.hero-kicker {
  margin-bottom: 12rpx;
  font-size: 20rpx;
  letter-spacing: 5rpx;
  opacity: 0.78;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-line {
  width: 68rpx;
  height: 4rpx;
  margin: 18rpx 0;
  border-radius: 4rpx;
  background: #d9b77e;
}

.hero-slogan {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  opacity: 0.94;
}

.page-content {
  padding: 0 28rpx 64rpx;
}

.lead-card,
.content-card,
.tech-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(134, 102, 59, 0.1);
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(74, 55, 31, 0.07);
}

.lead-card {
  position: relative;
  z-index: 2;
  margin-top: -32rpx;
  padding: 34rpx 38rpx;
  border-radius: 20rpx;
  text-align: center;
}

.lead-text {
  color: #76532e;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.8;
  letter-spacing: 1rpx;
}

.content-card {
  margin-top: 28rpx;
  padding: 0 36rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.content-section {
  padding: 42rpx 0;
  border-top: 1rpx solid #eee5d8;
}

.first-section {
  border-top: 0;
}

.section-heading {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.heading-mark {
  width: 8rpx;
  height: 32rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  background: #ae7a3c;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.paragraph,
.service-text,
.tech-text {
  display: block;
  color: #5e5850;
  font-size: 28rpx;
  line-height: 1.9;
  text-align: justify;
}

.tech-label {
  color: #af7f45;
  font-size: 20rpx;
  letter-spacing: 5rpx;
}

.section-summary {
  display: block;
  padding-left: 24rpx;
  color: #91877a;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.service-item {
  display: flex;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0e9df;
}

.last-service {
  padding-bottom: 0;
  border-bottom: 0;
}

.service-index {
  flex-shrink: 0;
  width: 68rpx;
  padding-top: 2rpx;
  color: #c29a65;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.service-body {
  flex: 1;
  min-width: 0;
}

.service-title {
  display: block;
  margin-bottom: 18rpx;
  color: #352d24;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.process-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  background: #f8f3ea;
}

.process-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #a9773d;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.process-arrow {
  margin: 0 8rpx;
  color: #c2aa88;
  font-size: 20rpx;
}

.tech-card {
  margin-top: 36rpx;
  padding: 42rpx 36rpx;
  border-radius: 20rpx;
  border-top: 6rpx solid #9a6a34;
  background: linear-gradient(145deg, #fff 0%, #fbf7f0 100%);
}

.tech-label {
  display: block;
  margin-bottom: 8rpx;
}

.tech-title {
  display: block;
  margin-bottom: 22rpx;
  color: #30281f;
  font-size: 34rpx;
  font-weight: 700;
}

@media (prefers-color-scheme: dark) {
  page {
    background: #f5f2ec;
  }
}
