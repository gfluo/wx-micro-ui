.page {
  background-color: #f9f9fb;
  padding: 16rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  overflow: hidden;
  transition: all 0.25s ease;
}
.card:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.08);
}

.cover {
  width: 100%;
  border-bottom: 1rpx solid #f0f0f0;
}

.info {
  padding: 16rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meta {
  font-size: 24rpx;
  color: #666;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cost {
  color: #f7760c;
  font-weight: 600;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.free {
  color: #32cd32;
  font-weight: 600;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.time, .duration {
  color: #0c1cf7;
  display: flex;
  align-items: center;
}
.label {
  color: #0c1cf7;
}

.back-to-top {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.15); /* 更透明 */
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  z-index: 999;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(4rpx); /* 轻微模糊 */
  transition: transform 0.25s ease, opacity 0.25s ease;
}
.back-to-top:active {
  transform: scale(0.9);
  opacity: 0.7;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.85; /* 图标也稍微透明一点 */
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background: transparent;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.25);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
}

.no-more {
  text-align: center;
  color: rgba(0, 0, 0, 0.4);
  font-size: 24rpx;
  padding: 40rpx 0;
  letter-spacing: 1rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

