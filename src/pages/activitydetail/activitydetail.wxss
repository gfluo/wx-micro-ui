/* src/pages/activitydetail/activitydetail.wxss */
.container {
  background-color: #fff;
  padding: 0.001rem;
  font-family: "PingFang SC", sans-serif;
  color: #333;
}

.top-image {
  width: 100%;
}

.title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #111;
  margin-left: 0.3rem;
}

.fee {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  margin-left: 0.5rem;
}

.fee-amount {
  font-size: 28rpx;
  font-weight: 500;
  color: #f7760c;
}

.fee-free {
  font-size: 28rpx;
  font-weight: 500;
  color: #98fb98;
}

.container-desc {
  padding: 24rpx;
  background: linear-gradient(to bottom, #f6fbff, #ffffff);
  font-family: "PingFang SC", sans-serif;
}

.activity-card {
  background: rgba(255, 255, 255, 0.25);
  /* 近乎透明 */
  border: 1px solid rgba(173, 216, 230, 0.3);
  /* 浅蓝边框 */
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(30, 144, 255, 0.08);
  padding: 2rpx;
  backdrop-filter: blur(10rpx);
}

.activity-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E90FF;
  margin-bottom: 24rpx;
  text-align: left;
}

.activity-desc {
  font-size: 28rpx;
  color: #4A90E2;
  line-height: 1.7;
  margin-bottom: 32rpx;
  text-align: left;
}

.section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E90FF;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #87CEFA;
  padding-left: 16rpx;
  text-align: left;
}

.section-title-body {
  font-size: 1.5rem;
  font-weight: 600;
  color:black;
  margin-bottom: 20rpx;
  border-left: 0rpx solid;
  padding-left: 16rpx;
  text-align: center;
}

.detail-row {
  display: flex;
  margin-bottom: 12rpx;
}

.label {
  width: 150rpx;
  color: #87CEFA;
  font-size: 26rpx;
}

.content {
  flex: 1;
  color: #1E90FF;
  font-size: 28rpx;
  font-weight: 500;
}

.stage-item {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #1E90FF;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E90FF;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #87CEFA;
  padding-left: 16rpx;
  text-align: left;
}

.stage-name {
  font-size: 28rpx;
  font-weight: 600;
  color: black;
  margin-bottom: 8rpx;
}

.stage-desc-link {
  font-size: 26rpx;
  color: #5DADE2;
  line-height: 1.6;
}

.stage-desc {
  font-size: 26rpx;
  color: black;
  line-height: 1.6;
}

.info {
  border-top: 1rpx solid #eee;
  padding-top: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  color: #1E90FF;
}

.body-describe {
  padding: 1px;
  line-height: 2;
  font-size: 14px;
  font-family: FangSong;
  background-color: rgb(248, 222, 165);
}

.body-culture {
  background-color: rgb(243, 198, 223);
  border-radius: 10px;
  padding: 20px;
  margin-top: 15px;
}

.body-forbidden {
  background-color: rgb(248, 248, 159);
  border-radius: 10px;
  padding: 20px;
  margin-top: 15px;
}

.body-refund {
  background-color: rgb(250, 217, 165);
  border-radius: 10px;
  padding: 20px;
  margin-top: 15px;
}

.desc-strong {
  font-weight: 700;
}

.fixed-button-wrap {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 999;
}

/* 超轻盈毛玻璃按钮 */
.fixed-button {
  width: 36%; /* 更窄 */
  padding: 10rpx 0; /* ✅ 高度降低 */
  border: none;
  border-radius: 60rpx;
  font-size: 24rpx; /* 字体微调匹配按钮比例 */
  font-weight: 600;
  color: #ffffff;
  background: rgba(30, 144, 255, 0.35); /* 浅蓝半透明 */
  backdrop-filter: blur(12rpx); /* 毛玻璃模糊 */
  -webkit-backdrop-filter: blur(12rpx);
  box-shadow: 0 4rpx 16rpx rgba(30, 144, 255, 0.2);
  letter-spacing: 2rpx;
  transition: all 0.25s ease;
}

/* 点击反馈 */
.fixed-button:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background: transparent;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.25);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
}
