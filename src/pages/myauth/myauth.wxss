/* pages/myauth/myauth.wxss */

.auth-container {
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #eef1f7, #dfe9f3);
}

/* 毛玻璃卡片 */
.glass-card {
  padding: 40rpx 60rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 24rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  text-align: center;
}

/* 主标题 */
.title {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
}

/* 副标题 */
.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}