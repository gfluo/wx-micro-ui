/* src/pages/myinfo/myinfo.wxss */
.page {
  background: #f5f6f8;
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

.page-bg {
  background: linear-gradient(180deg, #e8f8ff 0%, #f6fbff 40%, #ffffff 100%);
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 顶部信息卡片 */
.user-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 30rpx;
}

.avatar-wrap {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 30rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-info {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.gender-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 14rpx;
}


/* 分组 */
.group {
  margin-bottom: 26rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 每一行 */
.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1px solid #f0f0f0;
}

.item:last-child {
  border-bottom: none;
}

.left {
  font-size: 30rpx;
  color: #333;
}

.right-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.right-tips {
  font-size: 28rpx;
  color: #ff6b6b;
}

.right-value {
  font-size: 28rpx;
  color: #999;
}

.right-box {
  display: flex;
  flex-direction: row;
  align-items: center;   /* 垂直居中关键 */
  gap: 14rpx;
}

/* 优化后保持统一行高 & 字体 */
.right-tips {
  font-size: 28rpx;
  color: #ff6b6b;
  line-height: 1;
}

.right-value {
  font-size: 28rpx;
  color: #999;
  line-height: 1;
}

.right-arrow {
  font-size: 32rpx;
  color: #ccc;
  line-height: 1;
}